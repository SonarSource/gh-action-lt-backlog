{
  "name": "backlog-automation",
  "version": "1.0.0",
  "description": "BacklogAutomation",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "typecheck": "tsc",
    "bundle": "esbuild Index.ts --bundle --platform=node --target=node24 --format=cjs --log-level=warning --outfile=dist/Index.cjs",
    "bundle:debug": "npm run bundle -- --sourcemap",
    "test": "vitest run",
    "test-uts": "vitest run --exclude 'Data/*'",
    "test-data": "vitest run Data/",
    "format": "prettier --write \"**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.0",
    "@octokit/graphql": "^9.0.3"
  }
}
